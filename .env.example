GNANI_API_KEY=your-key-here
# Signs the login session cookie. Use a long random value and keep it out of git; changing it
# signs everyone out. Generate one with:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=generate-one-with-the-command-above
# Gnani calls the API may send (cached answers don't count); past it, new calls are refused.
GNANI_CALL_LIMIT=4000
# The account (by email) that may read GET /me/usage.
OWNER_EMAIL=you@example.com
# Sign-up needs this invite code when it is set; leave it empty for open sign-up. Anyone with
# the code can make an account, so share it only with demo users. Wrong codes are limited to
# 5 per IP per 15 minutes.
DEMO_INVITE_CODE=
# Gnani calls one account may send per day (UTC), on top of GNANI_CALL_LIMIT for everyone.
DAILY_CALL_CAP_PER_USER=60
# Optional Google OAuth Web Client ID for Sign in with Google (Google Identity Services).
# Leave empty to use email and password authentication only.
GOOGLE_CLIENT_ID=
# Where the database, recordings and caches go.
DATA_DIR=data
# 1 only behind a proxy that sets X-Forwarded-For, like Hugging Face Spaces (docs/DEPLOY.md).
# Leave it 0 on your own machine, or anyone could fake their address in that header.
TRUST_PROXY=0
# 1 answers every Gnani call with fake results (src/gnani_mock.py), to test without spending
# credits. Local testing only: the server refuses to start with both this and TRUST_PROXY on.
GNANI_MOCK=0
# The judge (src/llm_judge.py): after the matcher ranks a person's phrases, an LLM re-picks among
# the top 5. Only text is sent (what Prisma heard, the place, the time of day, the last 3 phrases
# spoken, the candidates); never audio, a name, an email or a user id. Any failure keeps the
# matcher's order. Off by default.
LLM_ENABLED=false
# Any OpenAI-compatible API. Keep the key in .env, never in git.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
# Reasoning models (openai/gpt-oss-*) only: keeps their thinking inside the 120-token answer.
# Leave it empty for any other model.
LLM_REASONING_EFFORT=low
# uncertain: ask only when the top two scores are within LLM_MARGIN, the top one is under
# LLM_MIN_SCORE (both as score / 100) or Prisma heard 2 words or fewer. always: every time.
LLM_MODE=uncertain
LLM_MARGIN=0.15
LLM_MIN_SCORE=0.6
LLM_TIMEOUT_S=3
# LLM calls one account may send per minute; past it, the matcher's order stands.
LLM_RATE_PER_MIN=10
# The trained reranker (src/reranker.py) as one more part of the score. Needs
# `uv sync --group rerank` and the exported model; without them it is one warning and stays off.
RERANKER_ENABLED=false
RERANKER_WEIGHT=20
RERANKER_PATH=ml/models/rerank-v2-onnx/model.onnx
RERANKER_THREADS=4
