GNANI_API_KEY=your-key-here
# Signs the login session cookie. Use a long random value and keep it out of git; changing it
# signs everyone out. Generate one with:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=generate-one-with-the-command-above
# Gnani calls the API may send (cached answers don't count); past it, new calls are refused.
GNANI_CALL_LIMIT=4000
# The account (by email) that may read GET /me/usage.
OWNER_EMAIL=you@example.com
# Sign-up needs this invite code when it is set; leave it empty for open sign-up. Anyone with
# the code can make an account, so share it only with demo users. Wrong codes are limited to
# 5 per IP per 15 minutes.
DEMO_INVITE_CODE=
