# ==============================================================================
# Sunn - Application Environment Configuration
# ==============================================================================
# Copy this file to .env and configure credentials for your environment.
# Never commit .env or any secret values into git.
# Run `uv run python -c "import secrets; print(secrets.token_urlsafe(48))"` to generate JWT_SECRET.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Speech Services (Gnani API)
# ------------------------------------------------------------------------------
# Sunn strictly isolates Speech-to-Text (STT) and Text-to-Speech (TTS) credentials.
# Prisma Speech-to-Text (STT) API credential:
# Used exclusively for live speech recognition and training pronunciation checks.
# Endpoint: https://api.vachana.ai/stt/v3
GNANI_STT_API_KEY=your-stt-key-here

# Timbre Text-to-Speech (TTS) and Voice Cloning API credential:
# Used exclusively for speech synthesis, spoken lesson prompts, and voice cloning.
# Endpoints: https://api.vachana.ai/api/v1/tts/inference, https://api.vachana.ai/api/v1/tts/voice-clone/embeddings
GNANI_TTS_API_KEY=your-tts-key-here
# Timbre model for the stock voices (src/speak.py VOICES are timbre-v2.5 voices). Optional.
# TIMBRE_MODEL=timbre-v2.5

# Server-wide total Gnani call limit across all users (cached calls do not count).
# Once reached, additional live speech requests return 429 credit_limit_reached.
GNANI_CALL_LIMIT=4000

# Per-user limits on calls sent to Gnani in a rolling 24 hours (cached answers never count).
# Past one, its requests return 429 daily_limit.
# Prisma for Speak, training checks and any other recognition:
STT_DAILY_LIMIT=20
# Timbre: speaking a phrase, listen buttons, voice preview and voice cloning:
TTS_DAILY_LIMIT=20
# Prisma for recording phrases while teaching Sunn (setup, onboarding, adding phrases):
ENROLL_DAILY_LIMIT=40
# Comma-separated accounts these limits never apply to. Empty means OWNER_EMAIL.
LIMIT_EXEMPT_EMAILS=

# Pronunciation similarity threshold (0.0 to 1.0) to mark a practice word clear.
WORD_CLEAR_THRESHOLD=0.70

# Set to 1 (or true) to use fake local fixtures (src/gnani_mock.py) for development
# and automated testing without spending Gnani API credits.
# The server refuses to start if both GNANI_MOCK and TRUST_PROXY are enabled.
GNANI_MOCK=0

# ------------------------------------------------------------------------------
# 2. AI Intelligence (Groq Cloud)
# ------------------------------------------------------------------------------
# Groq Cloud API key for AI assistant features (phrase re-ranking judge and
# dynamic "Easier ways to say it" phoneme alternatives).
# Server-side only; never exposed to the frontend browser bundle.
GROQ_API_KEY=

# Groq model identifier. Default is openai/gpt-oss-120b.
GROQ_MODEL=openai/gpt-oss-120b

# Base URL for OpenAI-compatible chat completions endpoint.
LLM_BASE_URL=https://api.groq.com/openai/v1

# Enable or disable the LLM phrase judge (src/llm_judge.py) and Groq fallback.
# Set to true to enable, false to disable (uses phonetic matcher only).
LLM_ENABLED=false

# Reasoning effort for reasoning models (e.g. low). Leave empty for standard models.
LLM_REASONING_EFFORT=low

# Judge invocation mode:
# 'uncertain' - invokes judge only when confidence margin is narrow or utterance is short.
# 'always'    - invokes judge on every phrase ranking candidate set.
LLM_MODE=uncertain

# Difference margin threshold between top two matcher scores (0.0 to 1.0).
LLM_MARGIN=0.15

# Minimum top candidate score below which the judge is consulted (0.0 to 1.0).
LLM_MIN_SCORE=0.6

# HTTP request timeout in seconds for Groq API calls.
LLM_TIMEOUT_S=3

# Maximum Groq API requests allowed per user per minute.
LLM_RATE_PER_MIN=10

# ------------------------------------------------------------------------------
# 3. Authentication & Security
# ------------------------------------------------------------------------------
# Secret key used to sign HTTP-only session cookies (HS256).
# Must be a high-entropy random string (at least 32 characters).
# Changing this secret invalidates all existing user login sessions.
JWT_SECRET=generate-one-with-the-command-above

# Account email authorized to view server-wide usage (GET /admin/usage), and by default
# exempt from the per-user daily limits above.
OWNER_EMAIL=you@example.com

# Anyone can sign up (email or Google); one IP address can make this many new accounts an hour.
# Behind a proxy, set TRUST_PROXY so each client is counted on its own.
SIGNUPS_PER_IP_PER_HOUR=5

# Optional Google OAuth Web Client ID for Sign in with Google (Google Identity Services).
# Leave empty to use email and password authentication only.
GOOGLE_CLIENT_ID=

# ------------------------------------------------------------------------------
# 4. Storage & Deployment
# ------------------------------------------------------------------------------
# Path to directory where SQLite database, user audio recordings, and cache files reside.
DATA_DIR=data

# Set to 1 only when running behind a trusted reverse proxy that sets X-Forwarded-For
# (e.g. Hugging Face Spaces). Keep 0 in local development to prevent header spoofing.
TRUST_PROXY=0

# ------------------------------------------------------------------------------
# 5. Local ONNX Phonetic Reranker (Optional)
# ------------------------------------------------------------------------------
# Enable the local ONNX sentence transformer reranker (src/reranker.py).
# Requires `uv sync --group rerank` and exported ONNX model files.
RERANKER_ENABLED=false
RERANKER_WEIGHT=20
RERANKER_PATH=ml/models/rerank-v2-onnx/model.onnx
RERANKER_THREADS=4
