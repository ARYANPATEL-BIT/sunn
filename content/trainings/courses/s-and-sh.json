              "sound_a": "s",
              "sound_b": "sh"
            }
          ]
        },
        {
          "id": "s-and-sh-2-round-lips",
          "type": "tip",
          "title": {"en": "Sh is rounder", "hi": "श में होंठ गोल"},
          "body": {
            "en": "For sh, move your tongue a little further back and round your lips, like the sound you make to hush a baby.",
            "hi": "श के लिए जीभ को थोड़ा पीछे ले जाइए और होंठ गोल कीजिए, जैसे किसी बच्चे को 'श्श्श' कहकर चुप कराते हैं।"
          },
          "technique_id": "tongue-place"
        },
        {
          "id": "s-and-sh-2-sh-words",
          "type": "listen_repeat",
          "title": {"en": "Words with sh", "hi": "श वाले शब्द"},
          "items": [
            {"id": "shaam", "text": "शाम", "latin": "shaam", "meaning_en": "evening", "focus_sound": "sh", "audio_key": "s-and-sh-shaam-word"},
