{
  "id": "s-and-sh",
  "category_id": "clear-sounds",
  "title": {"en": "S and Sh", "hi": "स और श"},
  "summary": {
    "en": "Hear the difference between s and sh, then practise each one. Useful practice if you lisp.",
    "hi": "स और श का फ़र्क़ सुनिए, फिर दोनों का अभ्यास कीजिए। तुतलाहट हो तो यह अभ्यास काम आता है।"
  },
  "what_you_practise": {
    "en": ["Where your tongue goes for s and sh", "Hearing s and sh apart", "Saying words and sentences with both"],
    "hi": ["स और श के लिए जीभ की जगह", "स और श का फ़र्क़ सुनना", "दोनों आवाज़ों वाले शब्द और वाक्य बोलना"]
  },
  "level": "beginner",
  "minutes": 13,
  "practice_lang": "hi",
  "lessons": [
    {
      "id": "s-and-sh-1",
      "title": {"en": "Find the s", "hi": "स को पहचानिए"},
      "minutes": 6,
      "steps": [
        {
          "id": "s-and-sh-1-welcome",
          "type": "intro",
          "title": {"en": "Welcome", "hi": "स्वागत है"},
          "body": {
            "en": "In these lessons you listen first, then say each sound. Go slowly and take all the time you need. Practise at your own pace.",
            "hi": "इन पाठों में पहले सुनिए, फिर हर आवाज़ बोलिए। धीरे-धीरे और आराम से अभ्यास कीजिए। अपनी रफ़्तार से आगे बढ़िए।"
          }
        },
        {
          "id": "s-and-sh-1-tongue",
          "type": "tip",
          "title": {"en": "Where the tongue goes", "hi": "जीभ कहाँ रहे"},
          "body": {
            "en": "For s, keep the tip of your tongue just behind your top teeth, not between them. Smile a little and let the air hiss out.",
            "hi": "स के लिए जीभ की नोक ऊपर के दाँतों के ठीक पीछे रखिए, दाँतों के बीच नहीं। थोड़ा मुस्कुराइए और हवा को 'स्स्स' की तरह निकलने दीजिए।"
          },
          "technique_id": "tongue-place"
        },
        {
          "id": "s-and-sh-1-hiss",
          "type": "breathing",
          "title": {"en": "A soft sss", "hi": "एक हल्की स्स्स"},
          "body": {
            "en": "Breathe in through your nose. As you breathe out, make a soft sss. Stop when it stops feeling comfortable.",
            "hi": "नाक से साँस लीजिए। साँस छोड़ते हुए हल्की 'स्स्स' बोलिए। जहाँ आराम न लगे, वहीं रुक जाइए।"
          },
          "pattern": {"in_s": 3, "out_s": 6},
          "rounds": 3
        },
        {
          "id": "s-and-sh-1-words",
          "type": "listen_repeat",
          "title": {"en": "Words with s", "hi": "स वाले शब्द"},
          "items": [
            {"id": "sab", "text": "सब", "latin": "sab", "meaning_en": "all", "focus_sound": "s", "audio_key": "s-and-sh-sab"},
            {"id": "saal", "text": "साल", "latin": "saal", "meaning_en": "year", "focus_sound": "s", "audio_key": "s-and-sh-saal"},
            {"id": "sona", "text": "सोना", "latin": "sona", "meaning_en": "to sleep", "focus_sound": "s", "audio_key": "s-and-sh-sona"},
            {"id": "bas", "text": "बस", "latin": "bas", "meaning_en": "bus", "focus_sound": "s", "audio_key": "s-and-sh-bas"},
            {"id": "raasta", "text": "रास्ता", "latin": "raasta", "meaning_en": "road", "focus_sound": "s", "audio_key": "s-and-sh-raasta"}
          ],
          "feedback": "words"
        },
        {
          "id": "s-and-sh-1-echo",
          "type": "speak_with_me",
          "title": {"en": "Sunn first, then you", "hi": "पहले Sunn, फिर आप"},
          "text": "सोनू सुबह सात बजे स्कूल जाता है",
          "latin": "sonu subah saat baje school jaata hai",
          "meaning_en": "Sonu goes to school at seven in the morning.",
          "mode": "echo",
          "pace_wpm": [70, 110],
          "audio_key": "s-and-sh-sonu",
          "feedback": "words"
        },
        {
          "id": "s-and-sh-1-reflect",
          "type": "reflect",
          "title": {"en": "How was that?", "hi": "कैसा लगा?"},
          "prompt": {"en": "How did the s sound feel today?", "hi": "आज स की आवाज़ कैसी लगी?"},
          "choices": ["easy", "okay", "hard"]
        }
      ]
    },
