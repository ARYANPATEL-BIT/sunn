{
  "id": "easy-starts",
  "category_id": "smooth-speaking",
  "title": {"en": "Easy starts", "hi": "आराम से शुरुआत"},
  "summary": {
    "en": "Begin words gently, on a slow breath out. Two short lessons.",
    "hi": "शब्दों को धीमी साँस छोड़ते हुए हल्के से शुरू कीजिए। दो छोटे पाठ।"
  },
  "what_you_practise": {
    "en": ["Breathing out slowly before you speak", "Starting the first sound softly", "Speaking along with Sunn at a calm pace"],
    "hi": ["बोलने से पहले धीरे-धीरे साँस छोड़ना", "पहली आवाज़ हल्के से शुरू करना", "Sunn के साथ आराम की रफ़्तार से बोलना"]
  },
  "level": "beginner",
  "minutes": 13,
  "practice_lang": "hi",
  "lessons": [
    {
      "id": "easy-starts-1",
      "title": {"en": "Breath and a soft start", "hi": "साँस और हल्की शुरुआत"},
      "minutes": 6,
      "steps": [
        {
          "id": "easy-starts-1-welcome",
          "type": "intro",
          "title": {"en": "Welcome", "hi": "स्वागत है"},
          "body": {
            "en": "This is a quiet place to practise. There is no rush and no test, and you can stop whenever you like. This is practice, not treatment. If you see a speech therapist, follow their advice first.",
            "hi": "यह अभ्यास की एक शांत जगह है। यहाँ कोई जल्दी नहीं है और कोई परीक्षा नहीं। जब चाहें रुक जाइए। यह अभ्यास है, इलाज नहीं। अगर किसी स्पीच थेरेपिस्ट से आपकी बात चल रही है, तो पहले उनकी सलाह मानिए।"
          }
        },
        {
          "id": "easy-starts-1-breathe",
          "type": "breathing",
          "title": {"en": "Slow breaths", "hi": "धीमी साँसें"},
          "body": {
            "en": "Breathe in through your nose, then let the air out slowly through your mouth. There is no need to hold your breath.",
            "hi": "नाक से साँस लीजिए, फिर मुँह से धीरे-धीरे छोड़िए। साँस रोकने की ज़रूरत नहीं है।"
          },
          "pattern": {"in_s": 3, "out_s": 5},
          "rounds": 4
        },
        {
          "id": "easy-starts-1-soft-start",
          "type": "tip",
          "title": {"en": "A soft start", "hi": "हल्की शुरुआत"},
          "body": {
            "en": "Let a little air flow out first. Then let the first sound begin softly, as if it rides on that breath.",
            "hi": "पहले थोड़ी हवा बाहर निकलने दीजिए। फिर पहली आवाज़ को हल्के से शुरू होने दीजिए, जैसे वह उसी साँस पर चल रही हो।"
          },
          "technique_id": "easy-start"
        },
        {
          "id": "easy-starts-1-vowels",
          "type": "listen_repeat",
          "title": {"en": "Words that start with a vowel", "hi": "स्वर से शुरू होने वाले शब्द"},
          "items": [
            {"id": "aam", "text": "आम", "latin": "aam", "meaning_en": "mango", "audio_key": "easy-starts-aam"},
            {"id": "aaj", "text": "आज", "latin": "aaj", "meaning_en": "today", "audio_key": "easy-starts-aaj"},
            {"id": "ek", "text": "एक", "latin": "ek", "meaning_en": "one", "audio_key": "easy-starts-ek"},
            {"id": "oopar", "text": "ऊपर", "latin": "oopar", "meaning_en": "up", "audio_key": "easy-starts-oopar"},
            {"id": "achchha", "text": "अच्छा", "latin": "achchha", "meaning_en": "good", "audio_key": "easy-starts-achchha"}
          ],
          "feedback": "none"
        },
        {
          "id": "easy-starts-1-together",
          "type": "speak_with_me",
          "title": {"en": "Say it together", "hi": "साथ में बोलिए"},
          "text": "आज मौसम अच्छा है",
          "latin": "aaj mausam achchha hai",
          "meaning_en": "The weather is nice today.",
          "mode": "choral",
          "pace_wpm": [60, 90],
          "audio_key": "easy-starts-mausam",
          "feedback": "pace"
        },
        {
          "id": "easy-starts-1-reflect",
          "type": "reflect",
          "title": {"en": "How was that?", "hi": "कैसा लगा?"},
          "prompt": {"en": "How did the soft starts feel today?", "hi": "आज हल्की शुरुआत कैसी लगी?"},
          "choices": ["easy", "okay", "hard"]
        }
      ]
    },
    {
      "id": "easy-starts-2",
      "title": {"en": "Light touches", "hi": "हल्का स्पर्श"},
      "minutes": 7,
      "steps": [
        {
          "id": "easy-starts-2-light-lips",
          "type": "tip",
          "title": {"en": "Light lips", "hi": "हल्के होंठ"},
          "body": {
            "en": "For p and b, let your lips meet lightly and part easily. There is no need to press them together.",
            "hi": "प और ब के लिए होंठों को हल्के से मिलने दीजिए और आराम से खुलने दीजिए। उन्हें दबाने की ज़रूरत नहीं है।"
          },
          "technique_id": "light-touch"
        },
        {
          "id": "easy-starts-2-pairs",
          "type": "minimal_pairs",
          "title": {"en": "Two close words", "hi": "दो मिलते-जुलते शब्द"},
          "pairs": [
            {
              "id": "pal-bal",
              "a": {"text": "पल", "latin": "pal", "audio_key": "easy-starts-pal"},
              "b": {"text": "बल", "latin": "bal", "audio_key": "easy-starts-bal"},
              "sound_a": "p",
              "sound_b": "b"
            },
            {
              "id": "padaa-badaa",
              "a": {"text": "पड़ा", "latin": "padaa", "audio_key": "easy-starts-padaa"},
              "b": {"text": "बड़ा", "latin": "badaa", "audio_key": "easy-starts-badaa"},
              "sound_a": "p",
              "sound_b": "b"
            }
          ]
        },
        {
          "id": "easy-starts-2-echo",
          "type": "speak_with_me",
          "title": {"en": "Sunn first, then you", "hi": "पहले Sunn, फिर आप"},
          "text": "मुझे एक कप चाय चाहिए",
          "latin": "mujhe ek cup chaay chaahiye",
          "meaning_en": "I would like a cup of tea.",
          "mode": "echo",
          "pace_wpm": [60, 90],
          "audio_key": "easy-starts-chaay",
          "feedback": "pace"
        },
        {
          "id": "easy-starts-2-paced",
          "type": "speak_with_me",
          "title": {"en": "Follow the words", "hi": "शब्दों के साथ चलिए"},
          "text": "मेरे पास बोलने के लिए पूरा समय है",
          "latin": "mere paas bolne ke liye poora samay hai",
          "meaning_en": "I have all the time I need to speak.",
          "mode": "paced",
          "pace_wpm": [50, 80],
          "feedback": "pace"
        },
        {
          "id": "easy-starts-2-read",
          "type": "read_aloud",
          "title": {"en": "Read a short note", "hi": "एक छोटा नोट पढ़िए"},
          "paragraph": "सुबह की हवा ठंडी और ताज़ा है। बाहर पेड़ों पर चिड़ियाँ बोल रही हैं। आज का दिन आराम से शुरू हो रहा है।",
          "latin": "subah ki hawa thandi aur taaza hai. baahar pedon par chidiyaan bol rahi hain. aaj ka din aaraam se shuru ho raha hai.",
          "audio_key": "easy-starts-morning",
          "feedback": "pace"
        },
        {
          "id": "easy-starts-2-tea-stall",
          "type": "dialogue",
          "title": {"en": "At the tea stall", "hi": "चाय की दुकान पर"},
          "scenario": {
            "en": "You are at a tea stall. Take one slow breath before each of your turns.",
            "hi": "आप चाय की दुकान पर हैं। अपनी हर बारी से पहले एक धीमी साँस लीजिए।"
          },
          "turns": [
            {"speaker": "sunn", "text": "नमस्ते! क्या लेंगे?", "latin": "namaste! kya lenge?", "audio_key": "easy-starts-stall-1"},
            {
              "speaker": "you",
              "text": "एक चाय, कम चीनी वाली।",
              "latin": "ek chaay, kam cheeni waali.",
              "options": [{"text": "एक चाय और दो बिस्कुट।", "latin": "ek chaay aur do biscuit."}]
            },
            {"speaker": "sunn", "text": "ठीक है, बीस रुपये।", "latin": "theek hai, bees rupaye.", "audio_key": "easy-starts-stall-2"},
            {"speaker": "you", "text": "धन्यवाद।", "latin": "dhanyavaad."}
          ]
        },
        {
          "id": "easy-starts-2-reflect",
          "type": "reflect",
          "title": {"en": "How was that?", "hi": "कैसा लगा?"},
          "prompt": {"en": "How did the light touches feel?", "hi": "हल्का स्पर्श कैसा लगा?"},
          "choices": ["easy", "okay", "hard"]
        }
      ]
    }
  ]
}
